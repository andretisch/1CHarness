Функция Сформировать(ПериодТекст) Экспорт
	НачалоПериода = ДатаИзТекста(ПериодТекст);
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Продажи.Номенклатура.Наименование КАК Номенклатура,
		|	Продажи.КоличествоОборот КАК Количество,
		|	Продажи.СуммаОборот КАК Сумма
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&Начало, ) КАК Продажи";
		Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Продажи.Номенклатура.Наименование КАК Номенклатура,
		|	Продажи.КоличествоОборот КАК Количество,
		|	Продажи.СуммаОборот КАК Сумма
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты КАК Продажи";
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Строки = Новый Массив;
	Итого = 0;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("Номенклатура", Строка(Выборка.Номенклатура));
		Запись.Вставить("Количество", Выборка.Количество);
		Запись.Вставить("Сумма", Выборка.Сумма);
		Итого = Итого + Выборка.Сумма;
		Строки.Добавить(Запись);
	КонецЦикла;
	Ответ = Новый Структура;
	Ответ.Вставить("columns", Колонки);
	Ответ.Вставить("rows", Строки);
	Ответ.Вставить("rowCount", Строки.Количество());
	Ответ.Вставить("total", Итого);
	Ответ.Вставить("period", СокрЛП(Строка(ПериодТекст)));
	Возврат Ответ;
КонецФункции

Функция ДатаИзТекста(Текст)
	Текст = СокрЛП(Строка(Текст));
	Если СтрДлина(Текст) < 10 Тогда
		Возврат '00010101';
	КонецЕсли;
	Если Сред(Текст, 5, 1) <> "-" Или Сред(Текст, 8, 1) <> "-" Тогда
		Возврат '00010101';
	КонецЕсли;
	Возврат Дата(Число(Лев(Текст, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)));
КонецФункции
