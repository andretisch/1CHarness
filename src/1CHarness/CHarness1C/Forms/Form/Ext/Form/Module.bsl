// Модуль формы 1СХарнесс. Чат в поле HTML, инструменты — на сервере пустой базы.
// Корень файлов агента: /workspace/workspace

&НаКлиенте
Перем ПоследнийЗапросМоста;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОпросМостаHTML", 1, Ложь);
	ЗагрузитьHTMLЧата();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ОтключитьОбработчикОжидания("ОпросМостаHTML");
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьHTMLЧата()
	Адрес = "file:///workspace/index.html?backend=1c";
	Попытка
		Элементы.ПолеHTML.Перейти(Адрес);
	Исключение
		Попытка
			Элементы.ПолеHTML.ПерейтиПоНавигационнойСсылке(Адрес);
		Исключение
			ЗапуститьПриложение("xdg-open " + Адрес + " &");
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОпросМостаHTML()
	ТекстЗапроса = ПрочитатьМостHTML();
	Если ПустаяСтрока(ТекстЗапроса) Или ТекстЗапроса = ПоследнийЗапросМоста Тогда
		Возврат;
	КонецЕсли;
	ПоследнийЗапросМоста = ТекстЗапроса;
	ОтветJSON = ВыполнитьЗапросМоста(ТекстЗапроса);
	ПередатьОтветВHTML(ОтветJSON);
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьМостHTML()
	Скрипт = "document.getElementById('harness-1c-bridge') ? document.getElementById('harness-1c-bridge').textContent : ''";
	Попытка
		Возврат Строка(Элементы.ПолеHTML.Документ.parentWindow.eval(Скрипт));
	Исключение
		Попытка
			Возврат Строка(Элементы.ПолеHTML.ВычислитьJavaScript(Скрипт));
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПередатьОтветВHTML(ОтветJSON)
	Скрипт = "window.harnessDeliverResponse&&window.harnessDeliverResponse(" + ОтветJSON + ")";
	Попытка
		Элементы.ПолеHTML.Документ.parentWindow.eval(Скрипт);
	Исключение
		Попытка
			Элементы.ПолеHTML.ВыполнитьJavaScript(Скрипт);
		Исключение
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьЗапросМоста(ТекстJSON)
	Попытка
		Данные = ПрочитатьJSONЗначение(ТекстJSON);
	Исключение
		Возврат ОтветОшибки("", "Некорректный JSON");
	КонецПопытки;
	Если НРег(Строка(Свойство(Данные, "type"))) <> "tool.invoke" Тогда
		Возврат ОтветОшибки(Строка(Свойство(Данные, "id")), "Неизвестный type");
	КонецЕсли;
	Ид = Строка(Свойство(Данные, "id"));
	Имя = Строка(Свойство(Данные, "tool"));
	Аргументы = Свойство(Данные, "arguments");
	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Попытка
		Результат = ВыполнитьИнструмент(Имя, Аргументы);
		Ответ = Новый Структура;
		Ответ.Вставить("type", "tool.result");
		Ответ.Вставить("id", Ид);
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("result", Результат);
		Возврат ВJSON(Ответ);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Текст = Инфо.Описание;
		Если СтрНайти(Текст, "сеансе 1С") = 0 И ЭтоПлатформенный(Имя) Тогда
			Текст = "Инструмент выполняется только в сеансе 1С с прикладной конфигурацией";
		КонецЕсли;
		Подсказки = Неопределено;
		Если Имя = "run_query" Тогда
			Подсказки = Новый Массив;
			Подсказки.Добавить("Пустая конфигурация: нет объектов метаданных");
			Подсказки.Добавить("Ссылки в params: { type, uuid }");
		КонецЕсли;
		Возврат ОтветОшибки(Ид, Текст, Подсказки);
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоПлатформенный(Имя)
	Имена = "run_query,inspect_metadata,read_object,make_navlink,sketch_query,delegate_task,report_describe,report_run,report_compose,open_draft";
	Возврат СтрНайти("," + Имена + ",", "," + Имя + ",") > 0;
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьИнструмент(Имя, Аргументы)
	Если Имя = "read_file" Тогда
		Имя = "fs_read";
	ИначеЕсли Имя = "write_file" Тогда
		Имя = "fs_write";
	КонецЕсли;
	Если ЭтоПлатформенный(Имя) Тогда
		ВызватьИсключение "Инструмент выполняется только в сеансе 1С";
	КонецЕсли;
	Если Имя = "session_now" Тогда
		Возврат СессияСейчас();
	ИначеЕсли Имя = "calc" Тогда
		Возврат Посчитать(Строка(Свойство(Аргументы, "expression")));
	ИначеЕсли Имя = "draw_chart" Тогда
		Возврат График(Аргументы);
	ИначеЕсли Имя = "find_in_chat" Тогда
		Возврат НайтиВЧатах(Строка(Свойство(Аргументы, "query")));
	ИначеЕсли Имя = "find_skill" Тогда
		Возврат НайтиНавык(Строка(Свойство(Аргументы, "query")));
	ИначеЕсли Имя = "read_agent_md" Тогда
		Возврат ПрочитатьФайл("agents/" + Строка(Свойство(Аргументы, "agent_id")));
	ИначеЕсли Имя = "fs_read" Тогда
		Возврат ПрочитатьФайл(Строка(Свойство(Аргументы, "path")));
	ИначеЕсли Имя = "fs_write" Тогда
		Возврат ЗаписатьФайл(Строка(Свойство(Аргументы, "path")), Строка(Свойство(Аргументы, "content")));
	ИначеЕсли Имя = "fs_list" Тогда
		Возврат СписокФайлов(Строка(Свойство(Аргументы, "path")));
	ИначеЕсли Имя = "fs_mkdir" Тогда
		Возврат СоздатьКаталогФайлов(Строка(Свойство(Аргументы, "path")));
	ИначеЕсли Имя = "fs_edit" Тогда
		Возврат ЗаменитьВФайле(Строка(Свойство(Аргументы, "path")), Строка(Свойство(Аргументы, "old_text")), Строка(Свойство(Аргументы, "new_text")));
	ИначеЕсли Имя = "fs_glob" Тогда
		Возврат НайтиПоМаске(Строка(Свойство(Аргументы, "pattern")));
	ИначеЕсли Имя = "fs_search" Тогда
		Возврат НайтиВФайлах(Строка(Свойство(Аргументы, "query")), Строка(Свойство(Аргументы, "path")));
	КонецЕсли;
	ВызватьИсключение "Неизвестный инструмент: " + Имя;
КонецФункции

&НаСервереБезКонтекста
Функция Корень()
	Возврат "/workspace/workspace";
КонецФункции

&НаСервереБезКонтекста
Функция ПолныйПуть(Относительный)
	Путь = СтрЗаменить(СокрЛП(Относительный), "\", "/");
	Пока Лев(Путь, 1) = "/" Цикл
		Путь = Сред(Путь, 2);
	КонецЦикла;
	Если ПустаяСтрока(Путь) Или СтрНайти("/" + Путь + "/", "/../") > 0 Тогда
		ВызватьИсключение "Недопустимый путь";
	КонецЕсли;
	Возврат Корень() + "/" + Путь;
КонецФункции

&НаСервереБезКонтекста
Функция СессияСейчас()
	Дата = ТекущаяДатаСеанса();
	Дни = Новый Массив;
	Дни.Добавить("понедельник");
	Дни.Добавить("вторник");
	Дни.Добавить("среда");
	Дни.Добавить("четверг");
	Дни.Добавить("пятница");
	Дни.Добавить("суббота");
	Дни.Добавить("воскресенье");
	Результат = Новый Структура;
	Результат.Вставить("iso", XMLСтрока(Дата));
	Результат.Вставить("weekday", Дни[ДеньНедели(Дата) - 1]);
	Результат.Вставить("local", Формат(Дата, "ДЛФ=DT"));
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция Посчитать(Выражение)
	Компактно = СтрЗаменить(СокрЛП(Выражение), " ", "");
	Допустимо = "0123456789.+-*/()eE%";
	Для Индекс = 1 По СтрДлина(Компактно) Цикл
		Если СтрНайти(Допустимо, Сред(Компактно, Индекс, 1)) = 0 Тогда
			ВызватьИсключение "Допустимы только числа и + - * / % скобки";
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Компактно) Тогда
		ВызватьИсключение "Пустое выражение";
	КонецЕсли;
	Значение = Вычислить(Компактно);
	Результат = Новый Структура;
	Результат.Вставить("expression", Выражение);
	Результат.Вставить("value", Значение);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция График(Аргументы)
	ТипГрафика = НРег(СокрЛП(Строка(Свойство(Аргументы, "type"))));
	Если ПустаяСтрока(ТипГрафика) Тогда
		ТипГрафика = "bar";
	ИначеЕсли СтрНайти(ТипГрафика, "hbar") > 0 Или СтрНайти(ТипГрафика, "гориз") > 0 Тогда
		ТипГрафика = "hbar";
	ИначеЕсли СтрНайти(ТипГрафика, "line") > 0 Или СтрНайти(ТипГрафика, "лин") > 0 Тогда
		ТипГрафика = "line";
	Иначе
		ТипГрафика = "bar";
	КонецЕсли;
	Подписи = Свойство(Аргументы, "labels");
	Данные = Свойство(Аргументы, "data");
	Если ТипЗнч(Подписи) <> Тип("Массив") Или ТипЗнч(Данные) <> Тип("Массив") Или Подписи.Количество() <> Данные.Количество() Или Подписи.Количество() = 0 Тогда
		ВызватьИсключение "labels и data — массивы одной длины из чисел";
	КонецЕсли;
	Ряд = Новый Структура;
	Ряд.Вставить("label", Строка(Свойство(Аргументы, "title")));
	Ряд.Вставить("data", Данные);
	Ряды = Новый Массив;
	Ряды.Добавить(Ряд);
	Спека = Новый Структура;
	Спека.Вставить("type", ТипГрафика);
	Спека.Вставить("title", Строка(Свойство(Аргументы, "title")));
	Спека.Вставить("labels", Подписи);
	Спека.Вставить("datasets", Ряды);
	Результат = Новый Структура;
	Результат.Вставить("chart", Спека);
	Результат.Вставить("hint", "Превью графика добавляет интерфейс чата.");
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьФайл(Относительный)
	Путь = ПолныйПуть(Относительный);
	Файл = Новый Файл(Путь);
	Если Не Файл.Существует() Или Не Файл.ЭтоФайл() Тогда
		ВызватьИсключение "Файл не найден: " + Относительный;
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Результат = Новый Структура;
	Результат.Вставить("path", Относительный);
	Результат.Вставить("content", Текст);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьФайл(Относительный, Содержимое)
	Путь = ПолныйПуть(Относительный);
	Каталог = Новый Файл(Лев(Путь, СтрНайти(Путь, "/", НаправлениеПоиска.СКонца) - 1));
	Если Не Каталог.Существует() Тогда
		СоздатьКаталог(Каталог.ПолноеИмя);
	КонецЕсли;
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();
	Результат = Новый Структура;
	Результат.Вставить("path", Относительный);
	Результат.Вставить("bytes", СтрДлина(Содержимое));
	Результат.Вставить("ok", Истина);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция СписокФайлов(Относительный)
	КаталогПуть = Корень();
	Если Не ПустаяСтрока(Относительный) Тогда
		КаталогПуть = ПолныйПуть(Относительный);
	КонецЕсли;
	Найденные = НайтиФайлы(КаталогПуть, "*", Ложь);
	ЭлементыСписка = Новый Массив;
	Для Каждого Файл Из Найденные Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("name", Файл.Имя);
		Элемент.Вставить("type", ?(Файл.ЭтоКаталог(), "dir", "file"));
		Элемент.Вставить("path", ?(ПустаяСтрока(Относительный), Файл.Имя, Относительный + "/" + Файл.Имя));
		ЭлементыСписка.Добавить(Элемент);
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("path", ?(ПустаяСтрока(Относительный), ".", Относительный));
	Результат.Вставить("entries", ЭлементыСписка);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьКаталогФайлов(Относительный)
	Путь = ПолныйПуть(Относительный);
	СоздатьКаталог(Путь);
	Результат = Новый Структура;
	Результат.Вставить("path", Относительный);
	Результат.Вставить("ok", Истина);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаменитьВФайле(Относительный, СтарыйТекст, НовыйТекст)
	Если ПустаяСтрока(СтарыйТекст) Тогда
		ВызватьИсключение "Пустой old_text";
	КонецЕсли;
	Данные = ПрочитатьФайл(Относительный);
	Текст = Данные.content;
	Количество = СтрЧислоВхождений(Текст, СтарыйТекст);
	Если Количество = 0 Тогда
		ВызватьИсключение "Фрагмент не найден";
	ИначеЕсли Количество > 1 Тогда
		ВызватьИсключение "Фрагмент встречается больше одного раза";
	КонецЕсли;
	Возврат ЗаписатьФайл(Относительный, СтрЗаменить(Текст, СтарыйТекст, НовыйТекст));
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоМаске(Маска)
	Если ПустаяСтрока(Маска) Тогда
		ВызватьИсключение "Пустой pattern";
	КонецЕсли;
	ИмяМаски = Маска;
	Если СтрНайти(Маска, "/") > 0 Тогда
		ИмяМаски = Сред(Маска, СтрНайти(Маска, "/", НаправлениеПоиска.СКонца) + 1);
	КонецЕсли;
	ИмяМаски = СтрЗаменить(ИмяМаски, "**", "*");
	Найденные = НайтиФайлы(Корень(), ИмяМаски, Истина);
	Пути = Новый Массив;
	Для Каждого Файл Из Найденные Цикл
		Если Не Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		Относительный = СтрЗаменить(Файл.ПолноеИмя, Корень() + "/", "");
		Пути.Добавить(Относительный);
		Если Пути.Количество() >= 200 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("pattern", Маска);
	Результат.Вставить("paths", Пути);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиВФайлах(Запрос, Относительный)
	Если ПустаяСтрока(Запрос) Тогда
		ВызватьИсключение "Пустой query";
	КонецЕсли;
	КаталогПуть = Корень();
	Если Не ПустаяСтрока(Относительный) Тогда
		КаталогПуть = ПолныйПуть(Относительный);
	КонецЕсли;
	Найденные = НайтиФайлы(КаталогПуть, "*.*", Истина);
	Хиты = Новый Массив;
	Для Каждого Файл Из Найденные Цикл
		Если Не Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		Расширение = НРег(Файл.Расширение);
		Если СтрНайти(".txt.md.json.xml.csv.bsl.js.html.css.log", Расширение) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Если СтрНайти(НРег(Текст), НРег(Запрос)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хит = Новый Структура;
		Хит.Вставить("path", СтрЗаменить(Файл.ПолноеИмя, Корень() + "/", ""));
		Хит.Вставить("excerpt", Лев(Текст, 120));
		Хиты.Добавить(Хит);
		Если Хиты.Количество() >= 30 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("query", Запрос);
	Результат.Вставить("hits", Хиты);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиВЧатах(Запрос)
	Если ПустаяСтрока(Запрос) Тогда
		ВызватьИсключение "Пустой query";
	КонецЕсли;
	Найденные = НайтиФайлы(Корень() + "/sessions", "*.json", Ложь);
	Хиты = Новый Массив;
	Для Каждого Файл Из Найденные Цикл
		Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Если СтрНайти(НРег(Текст), НРег(Запрос)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хит = Новый Структура;
		Хит.Вставить("session_id", Файл.ИмяБезРасширения);
		Хит.Вставить("excerpt", Лев(Текст, 120));
		Хиты.Добавить(Хит);
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("query", Запрос);
	Результат.Вставить("hits", Хиты);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиНавык(Запрос)
	Если ПустаяСтрока(Запрос) Тогда
		ВызватьИсключение "Пустой query";
	КонецЕсли;
	Хиты = Новый Массив;
	Для Каждого Папка Из СтрРазделить("skills,agents", ",", Ложь) Цикл
		Каталог = Новый Файл(Корень() + "/" + Папка);
		Если Не Каталог.Существует() Тогда
			Продолжить;
		КонецЕсли;
		Найденные = НайтиФайлы(Каталог.ПолноеИмя, "*.md", Истина);
		Для Каждого Файл Из Найденные Цикл
			Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
			Относительный = СтрЗаменить(Файл.ПолноеИмя, Корень() + "/", "");
			Если СтрНайти(НРег(Относительный + Символы.ПС + Текст), НРег(Запрос)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Хит = Новый Структура;
			Хит.Вставить("path", Относительный);
			Хит.Вставить("excerpt", Лев(Текст, 120));
			Хиты.Добавить(Хит);
		КонецЦикла;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("query", Запрос);
	Результат.Вставить("hits", Хиты);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция Свойство(Объект, Имя)
	Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Возврат Объект.Получить(Имя);
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Объект.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьJSONЗначение(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

&НаСервереБезКонтекста
Функция ВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция ОтветОшибки(Ид, Текст, Подсказки = Неопределено)
	Ответ = Новый Структура;
	Ответ.Вставить("type", "tool.result");
	Ответ.Вставить("id", Ид);
	Ответ.Вставить("ok", Ложь);
	Ответ.Вставить("error", Текст);
	Если Подсказки <> Неопределено Тогда
		Ответ.Вставить("hints", Подсказки);
	КонецЕсли;
	Возврат ВJSON(Ответ);
КонецФункции
