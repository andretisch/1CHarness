// Модуль управляемой формы внешней обработки 1СХарнесс

&НаКлиенте
Перем ИмяЭлементаHTML;
&НаКлиенте
Перем ПоследнийЗапросМоста;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИмяЭлементаHTML = "ПолеHTML";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ОпросМостаHTML", 1, Ложь);
	ЗагрузитьHTMLЧата();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ОтключитьОбработчикОжидания("ОпросМостаHTML");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьHTMLЧата()
	
	// Каталог репозитория / workspace при разработке в Cloud Agent
	Адрес = "file:///workspace/index.html?backend=1c&demo=1";
	
	Попытка
		Элементы[ИмяЭлементаHTML].ПерейтиПоНавигационнойСсылке(Адрес);
	Исключение
		// Fallback: открыть через систему, если поле недоступно
		ЗапуститьПриложение("xdg-open " + Адрес + " &");
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОпросМостаHTML()
	
	ТекстЗапроса = ПрочитатьМостHTML();
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекстЗапроса = ПоследнийЗапросМоста Тогда
		Возврат;
	КонецЕсли;
	
	ПоследнийЗапросМоста = ТекстЗапроса;
	ОтветJSON = ОбработатьСообщениеНаСервере(ТекстЗапроса);
	ПередатьОтветВHTML(ОтветJSON);
	
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьМостHTML()
	
	Попытка
		Скрипт = "document.getElementById('harness-1c-bridge') ? document.getElementById('harness-1c-bridge').textContent : ''";
		Возврат Элементы[ИмяЭлементаHTML].ВычислитьJavaScript(Скрипт);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ПередатьОтветВHTML(ОтветJSON)
	
	Попытка
		Скрипт = "window.harnessDeliverResponse && window.harnessDeliverResponse(" + ОтветJSON + ")";
		Элементы[ИмяЭлементаHTML].ВыполнитьJavaScript(Скрипт);
	Исключение
		// ignore
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ОбработатьСообщениеНаСервере(ТекстJSON)
	
	Возврат Объект.ОбработатьСообщение(ТекстJSON);
	
КонецФункции
