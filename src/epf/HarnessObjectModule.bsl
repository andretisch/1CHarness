// Модуль объекта внешней обработки 1СХарнесс (исходник для Конфигуратора / epf)

#Область ПрограммныйИнтерфейс

// Обрабатывает запрос чата из HTML (JSON: type, messages).
Функция ОбработатьСообщение(ТекстJSON) Экспорт
	
	Данные = ПрочитатьJSONВСтруктуру(ТекстJSON);
	Если Данные = Неопределено Тогда
		Возврат ОтветОшибки("Некорректный JSON");
	КонецЕсли;
	
	ТекстПользователя = ИзвлечьПоследнееСообщениеПользователя(Данные);
	ТекстОтвета = СформироватьОтветЗаглушку(ТекстПользователя);
	
	Возврат ОтветУспех(ТекстОтвета);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьJSONВСтруктуру(ТекстJSON)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Попытка
		Возврат ПрочитатьJSON(Чтение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ИзвлечьПоследнееСообщениеПользователя(Данные)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	
	Сообщения = Неопределено;
	Если Данные.Свойство("messages", Сообщения) И ТипЗнч(Сообщения) = Тип("Массив") Тогда
		Для Инд = Сообщения.ВГраница() По 0 Шаг -1 Цикл
			Элемент = Сообщения[Инд];
			Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Роль = "";
			Содержимое = "";
			Если Элемент.Свойство("role", Роль) И (НРег(Роль) = "user") И Элемент.Свойство("content", Содержимое) Тогда
				Возврат Строка(Содержимое);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СформироватьОтветЗаглушку(ТекстПользователя)
	
	Строка = СокрЛП(ТекстПользователя);
	Если СтрДлина(Строка) > 240 Тогда
		Строка = Лев(Строка, 240) + "…";
	КонецЕсли;
	
	Возврат "1СХарнесс: запрос принят." + Символы.ПС + Символы.ПС
		+ "Следующий шаг — инструменты, LLM и анонимизация на стороне платформы." + Символы.ПС + Символы.ПС
		+ "> " + ?(ПустаяСтрока(Строка), "(пустое сообщение)", Строка);
	
КонецФункции

Функция ОтветУспех(Текст)
	Возврат "{""content"":""" + ЭкранироватьJSON(Текст) + """}";
КонецФункции

Функция ОтветОшибки(Текст)
	Возврат "{""error"":""" + ЭкранироватьJSON(Текст) + """}";
КонецФункции

Функция ЭкранироватьJSON(Текст)
	Р = СтрЗаменить(Текст, "\", "\\");
	Р = СтрЗаменить(Р, """", "\""");
	Р = СтрЗаменить(Р, Символы.ПС, "\n");
	Р = СтрЗаменить(Р, Символы.ВК, "\r");
	Возврат Р;
КонецФункции

#КонецОбласти
