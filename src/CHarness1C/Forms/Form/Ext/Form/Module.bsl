&НаСервере
Функция НайтиМетаданные(ТекстИмени)
	ТекстИмени = СокрЛП(ТекстИмени);
	Если ПустаяСтрока(ТекстИмени) Тогда
		ВызватьИсключение "Не указано имя объекта";
	КонецЕсли;
	Позиция = СтрНайти(ТекстИмени, ".");
	Если Позиция > 0 Тогда
		Вид = Лев(ТекстИмени, Позиция - 1);
		Имя = Сред(ТекстИмени, Позиция + 1);
		Коллекция = КоллекцияМетаданных(Вид);
		ОбъектМД = Коллекция.Найти(Имя);
		Если ОбъектМД = Неопределено Тогда
			ВызватьИсключение "Объект не найден: " + ТекстИмени;
		КонецЕсли;
		Возврат ОбъектМД;
	КонецЕсли;
	Для Каждого Вид Из ВидыМетаданных() Цикл
		ОбъектМД = КоллекцияМетаданных(Вид).Найти(ТекстИмени);
		Если ОбъектМД <> Неопределено Тогда
			Возврат ОбъектМД;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Объект не найден: " + ТекстИмени;
КонецФункции

&НаСервере
Функция ВидыМетаданных()
	Виды = Новый Массив;
	Виды.Добавить("Справочник");
	Виды.Добавить("Документ");
	Виды.Добавить("РегистрСведений");
	Виды.Добавить("РегистрНакопления");
	Виды.Добавить("Отчет");
	Виды.Добавить("Обработка");
	Возврат Виды;
КонецФункции

&НаСервере
Функция КоллекцияМетаданных(Вид)
	ВидНРег = НРег(СокрЛП(Вид));
	Если ВидНРег = "справочник" Или ВидНРег = "catalog" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли ВидНРег = "документ" Или ВидНРег = "document" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли ВидНРег = "регистрсведений" Или ВидНРег = "informationregister" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли ВидНРег = "регистрнакопления" Или ВидНРег = "accumulationregister" Тогда
		Возврат Метаданные.РегистрыНакопления;
	ИначеЕсли ВидНРег = "отчет" Или ВидНРег = "report" Тогда
		Возврат Метаданные.Отчеты;
	ИначеЕсли ВидНРег = "обработка" Или ВидНРег = "dataprocessor" Тогда
		Возврат Метаданные.Обработки;
	КонецЕсли;
	ВызватьИсключение "Неизвестный вид метаданных: " + Вид;
КонецФункции

&НаСервере
Функция ПрочитатьОбъект(Сырой)
	Ссылка = СсылкаИзАргумента(Сырой);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Пустая ссылка";
	КонецЕсли;
	Данные = Ссылка.ПолучитьОбъект();
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Объект не найден";
	КонецЕсли;
	Мета = Данные.Метаданные();
	Карточка = ОписаниеСсылки(Ссылка);
	Поля = Новый Структура;
	ДобавитьЗначенияПолей(Поля, Данные, Мета, "СтандартныеРеквизиты");
	ДобавитьЗначенияПолей(Поля, Данные, Мета, "Реквизиты");
	Карточка.Вставить("fields", Поля);
	Попытка
		Части = Новый Массив;
		Для Каждого ТабличнаяЧасть Из Мета.ТабличныеЧасти Цикл
			СтрокиТЧ = Новый Массив;
			Для Каждого СтрокаТЧ Из Данные[ТабличнаяЧасть.Имя] Цикл
				ПоляСтроки = Новый Структура;
				Для Каждого Поле Из ТабличнаяЧасть.Реквизиты Цикл
					ПоляСтроки.Вставить(Поле.Имя, ЗначениеДляJSON(СтрокаТЧ[Поле.Имя]));
				КонецЦикла;
				СтрокиТЧ.Добавить(ПоляСтроки);
			КонецЦикла;
			Часть = Новый Структура;
			Часть.Вставить("name", ТабличнаяЧасть.Имя);
			Часть.Вставить("rows", СтрокиТЧ);
			Части.Добавить(Часть);
		КонецЦикла;
		Карточка.Вставить("tabularSections", Части);
	Исключение
	КонецПопытки;
	Возврат Карточка;
КонецФункции

&НаСервере
Процедура ДобавитьЗначенияПолей(Поля, Данные, Мета, ИмяКоллекции)
	Попытка
		Коллекция = Мета[ИмяКоллекции];
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого Поле Из Коллекция Цикл
		Если Поле.Имя = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Поля.Вставить(Поле.Имя, ЗначениеДляJSON(Данные[Поле.Имя]));
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция НавигационнаяСсылка(Сырой)
	Ссылка = СсылкаИзАргумента(Сырой);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Пустая ссылка";
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("url", ПолучитьНавигационнуюСсылку(Ссылка));
	Результат.Вставить("presentation", Строка(Ссылка));
	Возврат Результат;
КонецФункции

&НаСервере
Функция СсылкаИзАргумента(Сырой)
	Если ТипЗнч(Сырой) <> Тип("Соответствие") И ТипЗнч(Сырой) <> Тип("Структура") Тогда
		ВызватьИсключение "Ссылка должна быть объектом {type, uuid}";
	КонецЕсли;
	Если ТипЗнч(Сырой) = Тип("Структура") Тогда
		ТипСсылки = Строка(Сырой.type);
		Идентификатор = Строка(Сырой.uuid);
	Иначе
		ТипСсылки = Строка(Сырой.Получить("type"));
		Идентификатор = Строка(Сырой.Получить("uuid"));
	КонецЕсли;
	Части = СтрРазделить(ТипСсылки, ".");
	Если Части.Количество() < 2 Тогда
		ВызватьИсключение "Тип ссылки: Справочник.Имя или Документ.Имя";
	КонецЕсли;
	Вид = НРег(Части[0]);
	Имя = Части[1];
	ИдентификаторСсылки = Новый УникальныйИдентификатор(Идентификатор);
	Если Вид = "справочник" Или Вид = "catalog" Тогда
		Возврат Справочники[Имя].ПолучитьСсылку(ИдентификаторСсылки);
	ИначеЕсли Вид = "документ" Или Вид = "document" Тогда
		Возврат Документы[Имя].ПолучитьСсылку(ИдентификаторСсылки);
	КонецЕсли;
	ВызватьИсключение "Ссылку можно прочитать для справочника или документа";
КонецФункции

&НаСервере
Функция ОписаниеСсылки(Ссылка)
	Описание = Новый Структура;
	Описание.Вставить("type", Ссылка.Метаданные().ПолноеИмя());
	Описание.Вставить("uuid", Строка(Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("presentation", Строка(Ссылка));
	Возврат Описание;
КонецФункции

&НаСервере
Функция ЭскизЗапроса(Задача)
	Текст = НРег(Задача);
	Если СтрНайти(Текст, "продаж") > 0 Или СтрНайти(Текст, "оборот") > 0 Тогда
		Возврат ГотовыйЭскиз(
			"ВЫБРАТЬ Продажи.Номенклатура КАК Номенклатура, Продажи.Контрагент КАК Контрагент, Продажи.КоличествоОборот КАК Количество, Продажи.СуммаОборот КАК Сумма ИЗ РегистрНакопления.Продажи.Обороты КАК Продажи",
			"РегистрНакопления.Продажи",
			"Обороты регистра накопления Продажи");
	ИначеЕсли СтрНайти(Текст, "цен") > 0 Тогда
		Возврат ГотовыйЭскиз(
			"ВЫБРАТЬ Цены.Номенклатура КАК Номенклатура, Цены.ВидЦен КАК ВидЦен, Цены.Цена КАК Цена ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК Цены",
			"РегистрСведений.ЦеныНоменклатуры",
			"Срез последних регистра сведений ЦеныНоменклатуры");
	ИначеЕсли СтрНайти(Текст, "наклад") > 0 Или СтрНайти(Текст, "контрагент") > 0 Тогда
		Возврат ГотовыйЭскиз(
			"ВЫБРАТЬ Док.Ссылка КАК Ссылка, Док.Дата КАК Дата, Док.Контрагент КАК Контрагент ИЗ Документ.РасходнаяНакладная КАК Док",
			"Документ.РасходнаяНакладная",
			"Документы РасходнаяНакладная");
	ИначеЕсли СтрНайти(Текст, "номенклат") > 0 Или СтрНайти(Текст, "артикул") > 0 Тогда
		Возврат ГотовыйЭскиз(
			"ВЫБРАТЬ Номенклатура.Наименование КАК Наименование, Номенклатура.Артикул КАК Артикул, Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения ИЗ Справочник.Номенклатура КАК Номенклатура",
			"Справочник.Номенклатура",
			"Элементы справочника Номенклатура");
	КонецЕсли;
	ОбъектМД = ОбъектУпомянутыйВЗадаче(Текст);
	Если ОбъектМД = Неопределено Тогда
		ВызватьИсключение "Не удалось выбрать объект по задаче. Укажите номенклатуру, цены, накладную или продажи";
	КонецЕсли;
	Возврат ГотовыйЭскиз(
		"ВЫБРАТЬ ПЕРВЫЕ 50 Объект.Ссылка КАК Ссылка ИЗ " + ОбъектМД.ПолноеИмя() + " КАК Объект",
		ОбъектМД.ПолноеИмя(),
		"Эскиз по имени объекта");
КонецФункции

&НаСервере
Функция ГотовыйЭскиз(ТекстЗапроса, ПолноеИмя, Примечание)
	Объекты = Новый Массив;
	Объекты.Добавить(ПолноеИмя);
	Эскиз = Новый Структура;
	Эскиз.Вставить("query", ТекстЗапроса);
	Эскиз.Вставить("objects", Объекты);
	Эскиз.Вставить("note", Примечание);
	Возврат Эскиз;
КонецФункции

&НаСервере
Функция ОбъектУпомянутыйВЗадаче(Текст)
	Для Каждого Вид Из ВидыМетаданных() Цикл
		Для Каждого ОбъектМД Из КоллекцияМетаданных(Вид) Цикл
			Если СтрНайти(Текст, НРег(ОбъектМД.Имя)) > 0 Или СтрНайти(Текст, НРег(Строка(ОбъектМД.Синоним))) > 0 Тогда
				Возврат ОбъектМД;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ДелегироватьЗадачу(Задача)
	Эскиз = ЭскизЗапроса(Задача);
	Таблица = ВыполнитьЗапрос(Эскиз.query, 200);
	ИмяФайла = "data/delegate-" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0") + ".json";
	ЗаписатьФайл(ИмяФайла, ВJSON(Таблица));
	Таблица.Вставить("query", Эскиз.query);
	Таблица.Вставить("data_ref", ИмяФайла);
	Возврат Таблица;
КонецФункции

&НаСервере
Функция ОписатьОтчёты(Имя)
	ИмяНРег = НРег(СокрЛП(Имя));
	Найденные = Новый Массив;
	Для Каждого ОтчетМД Из Метаданные.Отчеты Цикл
		Совпало = ПустаяСтрока(ИмяНРег)
			Или СтрНайти(НРег(ОтчетМД.Имя), ИмяНРег) > 0
			Или СтрНайти(НРег(Строка(ОтчетМД.Синоним)), ИмяНРег) > 0;
		Если Совпало Тогда
			Найденные.Добавить(КраткоОтчёт(ОтчетМД));
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("found", Найденные.Количество() > 0);
	Результат.Вставить("reports", Найденные);
	Если Не Результат.found Тогда
		Результат.Вставить("note", "В конфигурации нет отчётов");
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Функция КраткоОтчёт(ОтчетМД)
	Макеты = Новый Массив;
	Для Каждого Макет Из ОтчетМД.Макеты Цикл
		Макеты.Добавить(Макет.Имя);
	КонецЦикла;
	Описание = Новый Структура;
	Описание.Вставить("fullName", ОтчетМД.ПолноеИмя());
	Описание.Вставить("name", ОтчетМД.Имя);
	Описание.Вставить("synonym", Строка(ОтчетМД.Синоним));
	Описание.Вставить("templates", Макеты);
	Попытка
		Описание.Вставить("hasSchema", Не ОтчетМД.ОсновнаяСхемаКомпоновкиДанных.Пустая());
	Исключение
		Описание.Вставить("hasSchema", Ложь);
	КонецПопытки;
	Возврат Описание;
КонецФункции

&НаСервере
Функция СформироватьОтчёт(Имя, Период)
	Описание = ОписатьОтчёты(Имя);
	Если Не Описание.found Тогда
		ВызватьИсключение "Отчёт не найден: " + Имя;
	КонецЕсли;
	Карточка = Описание.reports[0];
	МенеджерОтчета = Отчеты[Карточка.name];
	ОтчетОбъект = МенеджерОтчета.Создать();
	Таблица = ОтчетОбъект.Сформировать(Период);
	Таблица.Вставить("name", Карточка.name);
	Таблица.Вставить("synonym", Карточка.synonym);
	Таблица.Вставить("executed", Истина);
	Возврат Таблица;
КонецФункции

&НаСервере
Функция СобратьОтчёт(Задача)
	Если СтрНайти(НРег(Задача), "продаж") > 0 Тогда
		Таблица = СформироватьОтчёт("Продажи", "");
		Таблица.Вставить("task", Задача);
		Возврат Таблица;
	КонецЕсли;
	Эскиз = ЭскизЗапроса(Задача);
	Таблица = ВыполнитьЗапрос(Эскиз.query, 200);
