Функция ПосчитатьВыражение(Текст)
	Компактный = СтрЗаменить(СокрЛП(Текст), " ", "");
	Если ПустаяСтрока(Компактный) Тогда
		ВызватьИсключение "Пустое выражение";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Компактный) Цикл
		Символ = Сред(Компактный, Индекс, 1);
		Если СтрНайти("0123456789.+-*/()%eE", Символ) = 0 Тогда
			ВызватьИсключение "Допустимы только числа и + - * / % скобки";
		КонецЕсли;
	КонецЦикла;
	Состояние = Новый Структура("text, pos", Компактный, 1);
	Значение = РазобратьСложение(Состояние);
	Если Состояние.pos <= СтрДлина(Компактный) Тогда
		ВызватьИсключение "Лишние символы в выражении";
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("expression", СокрЛП(Текст));
	Результат.Вставить("value", Значение);
	Возврат Результат;
КонецФункции

&НаСервере
Функция РазобратьСложение(Состояние)
	Значение = РазобратьУмножение(Состояние);
	Пока Состояние.pos <= СтрДлина(Состояние.text) Цикл
		Оператор = Сред(Состояние.text, Состояние.pos, 1);
		Если Оператор <> "+" И Оператор <> "-" Тогда
			Прервать;
		КонецЕсли;
		Состояние.pos = Состояние.pos + 1;
		Право = РазобратьУмножение(Состояние);
		Если Оператор = "+" Тогда
			Значение = Значение + Право;
		Иначе
			Значение = Значение - Право;
		КонецЕсли;
	КонецЦикла;
	Возврат Значение;
КонецФункции

&НаСервере
Функция РазобратьУмножение(Состояние)
	Значение = РазобратьМножитель(Состояние);
	Пока Состояние.pos <= СтрДлина(Состояние.text) Цикл
		Оператор = Сред(Состояние.text, Состояние.pos, 1);
		Если Оператор <> "*" И Оператор <> "/" И Оператор <> "%" Тогда
			Прервать;
		КонецЕсли;
		Состояние.pos = Состояние.pos + 1;
		Право = РазобратьМножитель(Состояние);
		Если Оператор = "*" Тогда
			Значение = Значение * Право;
		ИначеЕсли Право = 0 Тогда
			ВызватьИсключение "Деление на ноль";
		ИначеЕсли Оператор = "/" Тогда
			Значение = Значение / Право;
		Иначе
			Значение = Значение - Право * Цел(Значение / Право);
		КонецЕсли;
	КонецЦикла;
	Возврат Значение;
КонецФункции

&НаСервере
Функция РазобратьМножитель(Состояние)
	Если Состояние.pos > СтрДлина(Состояние.text) Тогда
		ВызватьИсключение "Незаконченное выражение";
	КонецЕсли;
	Символ = Сред(Состояние.text, Состояние.pos, 1);
	Если Символ = "+" Или Символ = "-" Тогда
		Состояние.pos = Состояние.pos + 1;
		Значение = РазобратьМножитель(Состояние);
		Если Символ = "-" Тогда
			Возврат -Значение;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если Символ = "(" Тогда
		Состояние.pos = Состояние.pos + 1;
		Значение = РазобратьСложение(Состояние);
		Если Состояние.pos > СтрДлина(Состояние.text) Или Сред(Состояние.text, Состояние.pos, 1) <> ")" Тогда
			ВызватьИсключение "Нет закрывающей скобки";
		КонецЕсли;
		Состояние.pos = Состояние.pos + 1;
		Возврат Значение;
	КонецЕсли;
	Возврат ПрочитатьЧислоВыражения(Состояние);
КонецФункции

&НаСервере
Функция ПрочитатьЧислоВыражения(Состояние)
	Текст = Состояние.text;
	Длина = СтрДлина(Текст);
	Старт = Состояние.pos;
	Пока Состояние.pos <= Длина И СтрНайти("0123456789", Сред(Текст, Состояние.pos, 1)) > 0 Цикл
		Состояние.pos = Состояние.pos + 1;
	КонецЦикла;
	Если Состояние.pos <= Длина И Сред(Текст, Состояние.pos, 1) = "." Тогда
		Состояние.pos = Состояние.pos + 1;
		Пока Состояние.pos <= Длина И СтрНайти("0123456789", Сред(Текст, Состояние.pos, 1)) > 0 Цикл
			Состояние.pos = Состояние.pos + 1;
		КонецЦикла;
	КонецЕсли;
	Порядок = 0;
	Если Состояние.pos <= Длина И (Сред(Текст, Состояние.pos, 1) = "e" Или Сред(Текст, Состояние.pos, 1) = "E") Тогда
		Состояние.pos = Состояние.pos + 1;
		ЗнакПорядка = 1;
		Если Состояние.pos <= Длина И (Сред(Текст, Состояние.pos, 1) = "+" Или Сред(Текст, Состояние.pos, 1) = "-") Тогда
			Если Сред(Текст, Состояние.pos, 1) = "-" Тогда
				ЗнакПорядка = -1;
			КонецЕсли;
			Состояние.pos = Состояние.pos + 1;
		КонецЕсли;
		СтартПорядка = Состояние.pos;
		Пока Состояние.pos <= Длина И СтрНайти("0123456789", Сред(Текст, Состояние.pos, 1)) > 0 Цикл
			Состояние.pos = Состояние.pos + 1;
		КонецЦикла;
		Если Состояние.pos = СтартПорядка Тогда
			ВызватьИсключение "Некорректная запись числа";
		КонецЕсли;
		Порядок = ЗнакПорядка * Число(Сред(Текст, СтартПорядка, Состояние.pos - СтартПорядка));
	КонецЕсли;
	Если Состояние.pos = Старт Тогда
		ВызватьИсключение "Ожидалось число";
	КонецЕсли;
	Мантисса = Сред(Текст, Старт, Состояние.pos - Старт);
	ПозицияПорядка = СтрНайти(НРег(Мантисса), "e");
	Если ПозицияПорядка > 0 Тогда
		Мантисса = Лев(Мантисса, ПозицияПорядка - 1);
	КонецЕсли;
	Значение = Число(Мантисса);
	Если Порядок <> 0 Тогда
		Значение = Значение * Pow(10, Порядок);
	КонецЕсли;
	Возврат Значение;
КонецФункции

&НаСервере
Функция ПостроитьГрафик(Аргументы)
	ТипСырой = НРег(Строка(Аргументы.Получить("type")));
	ТипГрафика = "bar";
	Если СтрНайти(ТипСырой, "hbar") > 0 Или СтрНайти(ТипСырой, "гориз") > 0 Тогда
		ТипГрафика = "hbar";
	ИначеЕсли СтрНайти(ТипСырой, "line") > 0 Или СтрНайти(ТипСырой, "лин") > 0 Тогда
		ТипГрафика = "line";
	КонецЕсли;
	Подписи = Аргументы.Получить("labels");
	Данные = Аргументы.Получить("data");
	Если ТипЗнч(Подписи) <> Тип("Массив") Или ТипЗнч(Данные) <> Тип("Массив")
		Или Подписи.Количество() = 0 Или Подписи.Количество() <> Данные.Количество() Тогда
		ВызватьИсключение "labels и data — массивы одной длины из чисел";
	КонецЕсли;
	ПодписиСтроки = Новый Массив;
	Числа = Новый Массив;
	Для Индекс = 0 По Подписи.ВГраница() Цикл
		ПодписиСтроки.Добавить(Строка(Подписи[Индекс]));
		Числа.Добавить(Число(Данные[Индекс]));
	КонецЦикла;
	Заголовок = Строка(Аргументы.Получить("title"));
	Если Заголовок = "Неопределено" Тогда
		Заголовок = "";
	КонецЕсли;
	Ряд = Новый Структура;
	Ряд.Вставить("label", ?(ПустаяСтрока(Заголовок), "Ряд", Заголовок));
	Ряд.Вставить("data", Числа);
	Наборы = Новый Массив;
	Наборы.Добавить(Ряд);
	Спецификация = Новый Структура;
	Спецификация.Вставить("type", ТипГрафика);
	Спецификация.Вставить("title", Заголовок);
	Спецификация.Вставить("labels", ПодписиСтроки);
	Спецификация.Вставить("datasets", Наборы);
	Результат = Новый Структура;
	Результат.Вставить("chart", Спецификация);
	Результат.Вставить("hint", "Превью графика добавляет интерфейс чата.");
	Возврат Результат;
КонецФункции

&НаСервере
Функция НайтиВФайлах(ЗапросТекст, Относительный)
	Если ПустаяСтрока(СокрЛП(ЗапросТекст)) Тогда
		ВызватьИсключение "Пустой query";
	КонецЕсли;
	Каталог = КореньФайлов();
	Если Не ПустаяСтрока(Относительный) Тогда
		Каталог = ПолныйПуть(Относительный);
	КонецЕсли;
	Цель = Новый Файл(Каталог);
	Файлы = Новый Массив;
	Если Цель.Существует() И Не Цель.ЭтоКаталог() Тогда
		Файлы.Добавить(Цель);
	Иначе
		Для Каждого Файл Из НайтиФайлы(Каталог, "*", Истина) Цикл
			Файлы.Добавить(Файл);
		КонецЦикла;
	КонецЕсли;
	Хиты = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Если Файл.ЭтоКаталог() Или Файл.Размер() > 200000 Или Не ТекстовоеРасширение(Файл.Расширение) Тогда
			Продолжить;
		КонецЕсли;
		Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
		Если Содержимое = Неопределено Или СтрНайти(НРег(Содержимое), НРег(ЗапросТекст)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хит = Новый Структура;
		Хит.Вставить("path", ОтносительныйПутьФайла(Файл.ПолноеИмя));
		Хит.Вставить("excerpt", ФрагментТекста(Содержимое, ЗапросТекст));
		Хиты.Добавить(Хит);
		Если Хиты.Количество() >= 30 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("query", ЗапросТекст);
	Результат.Вставить("hits", Хиты);
	Возврат Результат;
КонецФункции

&НаСервере
Функция НайтиВДиалогах(ЗапросТекст)
	Если ПустаяСтрока(СокрЛП(ЗапросТекст)) Тогда
		ВызватьИсключение "Пустой query";
	КонецЕсли;
	Каталог = ПолныйПуть("sessions");
	Хиты = Новый Массив;
	КаталогФайлов = Новый Файл(Каталог);
	Если КаталогФайлов.Существует() Тогда
		Для Каждого Файл Из НайтиФайлы(Каталог, "*.json", Ложь) Цикл
			Если Файл.Размер() > 200000 Тогда
				Продолжить;
			КонецЕсли;
			Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
			Содержимое = Чтение.Прочитать();
			Чтение.Закрыть();
			Если Содержимое = Неопределено Или СтрНайти(НРег(Содержимое), НРег(ЗапросТекст)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Хит = Новый Структура;
			Хит.Вставить("session_id", Файл.ИмяБезРасширения);
			Хит.Вставить("excerpt", ФрагментТекста(Содержимое, ЗапросТекст));
			Хиты.Добавить(Хит);
			Если Хиты.Количество() >= 20 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("query", ЗапросТекст);
	Результат.Вставить("hits", Хиты);
