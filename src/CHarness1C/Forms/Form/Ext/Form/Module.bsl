&НаСервере
Функция ВыполнитьЗапросИзJSON(ТекстЗапроса, Параметры)
	Тело = Новый Структура;
	Тело.Вставить("type", "tool.invoke");
	Тело.Вставить("id", "params-check");
	Тело.Вставить("tool", "run_query");
	Аргументы = Новый Структура;
	Аргументы.Вставить("query", ТекстЗапроса);
	Аргументы.Вставить("params", Параметры);
	Тело.Вставить("arguments", Аргументы);
	ОтветТекст = ВыполнитьЗапросМоста(ВJSON(Тело));
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ОтветТекст);
	Ответ = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Если Ответ.Получить("ok") <> Истина Тогда
		ВызватьИсключение "params: " + Строка(Ответ.Получить("error"));
	КонецЕсли;
	Возврат Ответ.Получить("result");
КонецФункции

