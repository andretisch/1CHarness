&НаСервере
Функция НайтиИнструкцию(ЗапросТекст)
	Если ПустаяСтрока(СокрЛП(ЗапросТекст)) Тогда
		ВызватьИсключение "Пустой query";
	КонецЕсли;
	Хиты = Новый Массив;
	Для Каждого Папка Из СтрРазделить("skills,agents", ",", Ложь) Цикл
		Каталог = ПолныйПуть(Папка);
		КаталогФайлов = Новый Файл(Каталог);
		Если Не КаталогФайлов.Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Файл Из НайтиФайлы(Каталог, "*.md", Истина) Цикл
			Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
			Содержимое = Чтение.Прочитать();
			Чтение.Закрыть();
			Если Содержимое = Неопределено Или СтрНайти(НРег(Содержимое), НРег(ЗапросТекст)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Хит = Новый Структура;
			Хит.Вставить("path", ОтносительныйПутьФайла(Файл.ПолноеИмя));
			Хит.Вставить("excerpt", ФрагментТекста(Содержимое, ЗапросТекст));
			Хиты.Добавить(Хит);
			Если Хиты.Количество() >= 20 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("query", ЗапросТекст);
	Результат.Вставить("hits", Хиты);
	Возврат Результат;
КонецФункции

&НаСервере
Функция ТекстовоеРасширение(Расширение)
	Возврат СтрНайти(".txt.md.json.xml.csv.bsl.js.html.css.log.", НРег(Расширение) + ".") > 0;
КонецФункции

&НаСервере
Функция ОтносительныйПутьФайла(ПолноеИмя)
	Корень = КореньФайлов() + "/";
	Если СтрНачинаетсяС(ПолноеИмя, Корень) Тогда
		Возврат Сред(ПолноеИмя, СтрДлина(Корень) + 1);
	КонецЕсли;
	Возврат ПолноеИмя;
КонецФункции

&НаСервере
Функция ФрагментТекста(Текст, ЗапросТекст)
	Позиция = СтрНайти(НРег(Текст), НРег(ЗапросТекст));
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Старт = Макс(1, Позиция - 40);
	Фрагмент = Сред(Текст, Старт, СтрДлина(ЗапросТекст) + 120);
	Фрагмент = СтрЗаменить(Фрагмент, Символы.ПС, " ");
	Фрагмент = СтрЗаменить(Фрагмент, Символы.ВК, " ");
	Возврат Фрагмент;
КонецФункции

#КонецОбласти
