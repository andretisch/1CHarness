Функция ВыполнитьЗапросИзJSON(ТекстЗапроса, Параметры)
	Тело = Новый Структура;
	Тело.Вставить("type", "tool.invoke");
	Тело.Вставить("id", "params-check");
	Тело.Вставить("tool", "run_query");
	Аргументы = Новый Структура;
	Аргументы.Вставить("query", ТекстЗапроса);
