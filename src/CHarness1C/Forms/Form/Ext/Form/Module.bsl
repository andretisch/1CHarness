&НаКлиенте
Перем ПоследнийЗапрос;

&НаКлиенте
Перем ПоследняяОшибкаМоста;

&НаКлиенте
Перем ПоследнийЗаголовок;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаписатьСтрокуЖурнала("старт", Истина);
	Попытка
		Зафиксировать(ПодготовитьДанныеУНФ());
	Исключение
		Зафиксировать("ОШИБКА данных: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		Зафиксировать(СамопроверкаИнструментов());
	Исключение
		Зафиксировать("ОШИБКА инструментов: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		Обработка = РеквизитФормыВЗначение("Объект");
		Текст = Обработка.ПолучитьМакет("Страница").ПолучитьТекст();
		Текст = СтрЗаменить(Текст, "<head>", "<head><script>window.__1CHarnessBackend=true;setInterval(function(){var el=document.getElementById('harness-1c-result');if(!el)return;var raw=el.textContent||el.innerText||el.getAttribute('data-payload')||'';if(!raw)return;el.textContent='';try{el.setAttribute('data-payload','');}catch(e){}if(window.harnessDeliverResponse){try{window.harnessDeliverResponse(raw);}catch(e){}}},200);</script>");
		Текст = СтрЗаменить(Текст, "<body>", "<body><div id=""harness-1c-result"" hidden></div>");
		ИмяФайла = ПолучитьИмяВременногоФайла("html");
		ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(ИмяФайла);
		АдресЧата = "file://" + ИмяФайла;
		Зафиксировать("поле=" + АдресЧата);
	Исключение
		Зафиксировать("ОШИБКА страницы: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПоследнийЗапрос = "";
	ПоследняяОшибкаМоста = "";
	ПоследнийЗаголовок = "";
	ПодключитьОбработчикОжидания("ОпросМоста", 1, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLДокументСформирован(Элемент)
	Попытка
		Зафиксировать("документ: " + Строка(Элемент.Документ.title));
	Исключение
		Зафиксировать("документ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОпросМоста()
	ЗафиксироватьЗаголовок();
	Текст = "";
	Попытка
		Текст = ПрочитатьМост();
	Исключение
		СообщитьОшибкуМоста("мост чтение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если ПустаяСтрока(Текст) Или Текст = ПоследнийЗапрос Тогда
		Возврат;
	КонецЕсли;
	ПоследнийЗапрос = Текст;
	Зафиксировать("мост запрос: " + Лев(Текст, 160));
	Ответ = ОтветЕслиКлиентскийИнструмент(Текст);
	Если ПустаяСтрока(Ответ) Тогда
		Ответ = ВыполнитьЗапросМоста(Текст);
	КонецЕсли;
	Попытка
		ЗаписатьОтветМоста(Ответ);
		Зафиксировать("мост ответ: " + Лев(Ответ, 80));
	Исключение
		СообщитьОшибкуМоста("мост запись: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗафиксироватьЗаголовок();
КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьЗаголовок()
	Попытка
		Заголовок = Строка(Элементы.ПолеHTML.Документ.title);
	Исключение
		Возврат;
	КонецПопытки;
	Если Заголовок = ПоследнийЗаголовок Тогда
		Возврат;
	КонецЕсли;
	ПоследнийЗаголовок = Заголовок;
	Зафиксировать("title=" + Заголовок);
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОшибкуМоста(Текст)
	Если Текст = ПоследняяОшибкаМоста Тогда
		Возврат;
	КонецЕсли;
	ПоследняяОшибкаМоста = Текст;
	Зафиксировать(Текст);
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьМост()
	ДокументПоля = Элементы.ПолеHTML.Документ;
	Если ДокументПоля = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Узел = ДокументПоля.getElementById("harness-1c-bridge");
	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Узел.textContent);
КонецФункции

&НаКлиенте
Процедура ЗаписатьОтветМоста(Ответ)
	ДокументПоля = Элементы.ПолеHTML.Документ;
	Узел = ДокументПоля.getElementById("harness-1c-result");
	Узел.textContent = Ответ;
	Попытка
		Узел.innerText = Ответ;
	Исключение
	КонецПопытки;
	Попытка
		Узел.setAttribute("data-payload", Ответ);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ОтветЕслиКлиентскийИнструмент(ТекстJSON)
	План = ПланКлиентскогоИнструмента(ТекстJSON);
	Если План = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если План.Свойство("error") Тогда
		Возврат ОтветОшибки(План.id, План.error);
	КонецЕсли;
	Попытка
		ПараметрыФормы = Новый Структура;
		Если План.Свойство("fill") И План.fill <> Неопределено Тогда
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", План.fill);
		КонецЕсли;
		Форма = ОткрытьФорму(План.form, ПараметрыФормы, ЭтотОбъект);
		Если План.Свойство("fill") И План.fill <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Форма.Объект, План.fill);
		КонецЕсли;
		Зафиксировать("черновик: " + План.form + " контрагент=" + Строка(Форма.Объект.Контрагент));
	Исключение
		Возврат ОтветОшибки(План.id, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Результат = Новый Структура;
	Результат.Вставить("form", План.form);
	Результат.Вставить("opened", Истина);
	Возврат ОтветУспеха(План.id, Результат);
КонецФункции

&НаСервере
Функция ВыполнитьЗапросМоста(ТекстJSON)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат ОтветОшибки("", "Некорректный JSON");
	КонецПопытки;
	Если НРег(Строка(Данные.Получить("type"))) <> "tool.invoke" Тогда
		Возврат ОтветОшибки(Строка(Данные.Получить("id")), "Неизвестный type");
	КонецЕсли;
	Ид = Строка(Данные.Получить("id"));
	Имя = Строка(Данные.Получить("tool"));
	Аргументы = Данные.Получить("arguments");
	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	Попытка
		Результат = ВыполнитьИнструмент(Имя, Аргументы);
		Ответ = Новый Структура;
		Ответ.Вставить("type", "tool.result");
		Ответ.Вставить("id", Ид);
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("result", Результат);
		Возврат ВJSON(Ответ);
	Исключение
		Возврат ОтветОшибки(Ид, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецФункции

&НаСервере
Функция ВыполнитьИнструмент(Имя, Аргументы)
	Если Имя = "run_query" Тогда
		Возврат ВыполнитьЗапрос(Строка(Аргументы.Получить("query")), Аргументы.Получить("limit"), Аргументы.Получить("params"));
	ИначеЕсли Имя = "inspect_metadata" Тогда
		Возврат ОсмотретьМетаданные(Строка(Аргументы.Получить("name")));
	ИначеЕсли Имя = "read_object" Тогда
		Возврат ПрочитатьОбъект(Аргументы.Получить("ref"));
	ИначеЕсли Имя = "make_navlink" Тогда
		Возврат НавигационнаяСсылка(Аргументы.Получить("ref"));
	ИначеЕсли Имя = "sketch_query" Тогда
		Возврат ЭскизЗапроса(Строка(Аргументы.Получить("task")));
	ИначеЕсли Имя = "delegate_task" Тогда
		Возврат ДелегироватьЗадачу(Строка(Аргументы.Получить("task")));
	ИначеЕсли Имя = "report_describe" Тогда
		Возврат ОписатьОтчёты(Строка(Аргументы.Получить("name")));
	ИначеЕсли Имя = "report_run" Тогда
		Возврат СформироватьОтчёт(Строка(Аргументы.Получить("name")), Строка(Аргументы.Получить("period")));
	ИначеЕсли Имя = "report_compose" Тогда
		Возврат СобратьОтчёт(Строка(Аргументы.Получить("task")));
	ИначеЕсли Имя = "fs_read" Или Имя = "read_file" Тогда
		Возврат ПрочитатьФайл(Строка(Аргументы.Получить("path")));
	ИначеЕсли Имя = "fs_write" Или Имя = "write_file" Тогда
		Возврат ЗаписатьФайл(Строка(Аргументы.Получить("path")), Строка(Аргументы.Получить("content")));
	ИначеЕсли Имя = "fs_list" Тогда
		Возврат СписокФайлов(Строка(Аргументы.Получить("path")));
	КонецЕсли;
	ВызватьИсключение "Инструмент в этой сборке не подключён: " + Имя;
КонецФункции

&НаСервере
Функция ВыполнитьЗапрос(ТекстЗапроса, ЛимитСырой, Параметры = Неопределено)
	Если ПустаяСтрока(СокрЛП(ТекстЗапроса)) Тогда
		ВызватьИсключение "Пустой текст запроса";
	КонецЕсли;
	Лимит = 50;
	Если ЛимитСырой <> Неопределено И Строка(ЛимитСырой) <> "" Тогда
		Лимит = Число(ЛимитСырой);
	КонецЕсли;
	Если Лимит < 1 Или Лимит > 200 Тогда
		Лимит = 50;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	УстановитьПараметрыЗапроса(Запрос, Параметры);
	РезультатЗапроса = Запрос.Выполнить();
	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Строки = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() И Строки.Количество() < Лимит Цикл
		Запись = Новый Структура;
		Для Каждого ИмяКолонки Из Колонки Цикл
			Запись.Вставить(ИмяКолонки, ЗначениеДляJSON(Выборка[ИмяКолонки]));
		КонецЦикла;
		Строки.Добавить(Запись);
	КонецЦикла;
	Ответ = Новый Структура;
	Ответ.Вставить("columns", Колонки);
	Ответ.Вставить("rows", Строки);
	Ответ.Вставить("rowCount", Строки.Количество());
	Возврат Ответ;
КонецФункции

&НаСервере
Процедура УстановитьПараметрыЗапроса(Запрос, Параметры)
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТипПараметров = ТипЗнч(Параметры);
	Если ТипПараметров <> Тип("Соответствие") И ТипПараметров <> Тип("Структура") Тогда
		ВызватьИсключение "params должен быть объектом";
	КонецЕсли;
	Для Каждого Пара Из Параметры Цикл
		Имя = СокрЛП(Строка(Пара.Ключ));
		Если Лев(Имя, 1) = "&" Тогда
			Имя = Сред(Имя, 2);
		КонецЕсли;
		Если ПустаяСтрока(Имя) Тогда
			ВызватьИсключение "Пустое имя параметра";
		КонецЕсли;
		Запрос.УстановитьПараметр(Имя, ЗначениеПараметраЗапроса(Пара.Значение));
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ЗначениеПараметраЗапроса(Значение)
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоОписаниеСсылки(Значение) Тогда
		Возврат СсылкаИзАргумента(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Список = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Список.Добавить(ЗначениеПараметраЗапроса(Элемент));
		КонецЦикла;
		Возврат Список;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И ЭтоДатаISO(Значение) Тогда
		ТекстДаты = Значение;
		Если СтрДлина(ТекстДаты) = 10 Тогда
			ТекстДаты = ТекстДаты + "T00:00:00";
		ИначеЕсли СтрДлина(ТекстДаты) = 19 И Сред(ТекстДаты, 11, 1) = " " Тогда
			ТекстДаты = Лев(ТекстДаты, 10) + "T" + Сред(ТекстДаты, 12);
		КонецЕсли;
		Возврат XMLЗначение(Тип("Дата"), ТекстДаты);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("Структура") Тогда
		ВызватьИсключение "Параметр-объект должен быть ссылкой {type, uuid}";
	КонецЕсли;
	Возврат Значение;
КонецФункции

&НаСервере
Функция ЭтоОписаниеСсылки(Значение)
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение.Получить("type") <> Неопределено И Значение.Получить("uuid") <> Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат Значение.Свойство("type") И Значение.Свойство("uuid");
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция ЭтоДатаISO(Текст)
	Если СтрДлина(Текст) = 10 Тогда
		Возврат Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-";
	КонецЕсли;
	Если СтрДлина(Текст) = 19 Тогда
		Разделитель = Сред(Текст, 11, 1);
		Возврат Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-" И (Разделитель = "T" Или Разделитель = " ");
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция ЗначениеДляJSON(Значение)
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Или Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат ОписаниеСсылки(Значение);
	КонецЕсли;
	Если Тип = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

&НаСервере
Функция КореньФайлов()
	Возврат "/workspace/workspace";
КонецФункции

&НаСервере
Функция ПолныйПуть(Относительный)
	Путь = СтрЗаменить(СокрЛП(Относительный), "\", "/");
	Пока Лев(Путь, 1) = "/" Цикл
		Путь = Сред(Путь, 2);
	КонецЦикла;
	Если ПустаяСтрока(Путь) Или СтрНайти("/" + Путь + "/", "/../") > 0 Тогда
		ВызватьИсключение "Недопустимый путь";
	КонецЕсли;
	Возврат КореньФайлов() + "/" + Путь;
КонецФункции

&НаСервере
Функция ПрочитатьФайл(Относительный)
	Путь = ПолныйПуть(Относительный);
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Если Содержимое = Неопределено Тогда
		Содержимое = "";
	КонецЕсли;
	Возврат Новый Структура("path, content", Относительный, Содержимое);
КонецФункции

&НаСервере
Функция ЗаписатьФайл(Относительный, Содержимое)
	Путь = ПолныйПуть(Относительный);
	ФайлНаДиске = Новый Файл(Путь);
	СоздатьКаталог(ФайлНаДиске.Путь);
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();
	Возврат Новый Структура("path, bytes", Относительный, СтрДлина(Содержимое));
КонецФункции

&НаСервере
Функция СписокФайлов(Относительный)
	Каталог = КореньФайлов();
	Если Не ПустаяСтрока(Относительный) Тогда
		Каталог = ПолныйПуть(Относительный);
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Файл Из НайтиФайлы(Каталог, "*") Цикл
		Имена.Добавить(Файл.Имя);
	КонецЦикла;
	Возврат Новый Структура("path, entries", Относительный, Имена);
КонецФункции

&НаСервере
Функция ПодготовитьДанныеУНФ()
	Кабель = ОбеспечитьНоменклатуру("Кабель ВВГнг 3х2,5", "CBL-325", "м");
	Розетка = ОбеспечитьНоменклатуру("Розетка Schneider Этюд", "SCH-ET", "шт");
	Монтаж = ОбеспечитьНоменклатуру("Монтаж розетки", "SRV-MNT", "усл");
	ЗаписатьРозничнуюЦену(Кабель, 85);
	ЗаписатьРозничнуюЦену(Розетка, 320);
	ЗаписатьРозничнуюЦену(Монтаж, 500);
	Если ДокументовНет() Тогда
		Док = Документы.РасходнаяНакладная.СоздатьДокумент();
		Док.Дата = Дата(2026, 10, 20, 12, 0, 0);
		Док.Контрагент = "ООО Ромашка";
		ДобавитьЗапас(Док, Кабель, 20, 85);
		ДобавитьЗапас(Док, Розетка, 4, 320);
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	Проверка = Новый Запрос;
	Проверка.Текст = "ВЫБРАТЬ СУММА(Продажи.СуммаОборот) КАК Сумма ИЗ РегистрНакопления.Продажи.Обороты КАК Продажи";
	Выборка = Проверка.Выполнить().Выбрать();
	Сумма = 0;
	Если Выборка.Следующий() И ТипЗнч(Выборка.Сумма) <> Тип("Null") Тогда
		Сумма = Выборка.Сумма;
	КонецЕсли;
	Возврат "данные УНФ: номенклатура 3, цены розничные, расходная накладная ООО Ромашка, сумма продаж=" + Строка(Сумма);
КонецФункции

