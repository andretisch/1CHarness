&НаСервере
Функция ПланКлиентскогоИнструмента(ТекстJSON)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если НРег(Строка(Данные.Получить("tool"))) <> "open_draft" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Аргументы = Данные.Получить("arguments");
	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Соответствие;
	КонецЕсли;
	План = Новый Структура;
	План.Вставить("id", Строка(Данные.Получить("id")));
	Попытка
		План.Вставить("form", ИмяФормыЧерновика(Строка(Аргументы.Получить("type"))));
	Исключение
		План.Вставить("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат План;
	КонецПопытки;
	Заполнение = СтруктураЗаполнения(Аргументы.Получить("fill"));
	Если Заполнение.Количество() > 0 Тогда
		План.Вставить("fill", Заполнение);
	КонецЕсли;
	Возврат План;
КонецФункции

&НаСервере
Функция ИмяФормыЧерновика(ТипОбъекта)
	ТипОбъекта = СокрЛП(ТипОбъекта);
	ТипОбъекта = СтрЗаменить(ТипОбъекта, "Catalog.", "Справочник.");
	ТипОбъекта = СтрЗаменить(ТипОбъекта, "Document.", "Документ.");
	Если СтрНайти(ТипОбъекта, ".") = 0 Тогда
		ВызватьИсключение "Тип черновика: Документ.Имя или Справочник.Имя";
	КонецЕсли;
	Возврат ТипОбъекта + ".ФормаОбъекта";
КонецФункции

&НаСервере
Функция СтруктураЗаполнения(Сырой)
	Заполнение = Новый Структура;
	Если ТипЗнч(Сырой) <> Тип("Соответствие") Тогда
		Возврат Заполнение;
	КонецЕсли;
	Для Каждого Пара Из Сырой Цикл
		Ключ = Строка(Пара.Ключ);
		ТипЗначения = ТипЗнч(Пара.Значение);
		Если ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("Массив")
			Или ТипЗначения = Тип("Null") Или Пара.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Заполнение.Вставить(Ключ, Пара.Значение);
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Заполнение;
КонецФункции

