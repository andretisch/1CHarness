&НаКлиенте
Перем ПроверкаСделана;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаписатьСтрокуЖурнала("старт", Истина);
	Попытка
		Обработка = РеквизитФормыВЗначение("Объект");
		Макет = Обработка.ПолучитьМакет("Страница");
		Текст = Макет.ПолучитьТекст();
		Зафиксировать("макет тип=" + Строка(ТипЗнч(Макет)) + " длина=" + Строка(СтрДлина(Текст)));
		ИмяФайла = ПолучитьИмяВременногоФайла("html");
		Двоичные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
		Двоичные.Записать(ИмяФайла);
		ФайлСтраницы = Новый Файл(ИмяФайла);
		АдресЧата = "file://" + ИмяФайла;
		Зафиксировать("файл=" + ИмяФайла + " размер=" + Строка(ФайлСтраницы.Размер()) + " поле=" + АдресЧата);
	Исключение
		Зафиксировать("ОШИБКА загрузки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПроверкаСделана = Ложь;
	ПодключитьОбработчикОжидания("ПроверитьПолеHTML", 2, Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПолеHTMLДокументСформирован(Элемент)
	Зафиксировать("ДокументСформирован: " + СнятьСведенияПоля());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьПолеHTML()
	Если ПроверкаСделана Тогда
		Возврат;
	КонецЕсли;
	ПроверкаСделана = Истина;
	Зафиксировать("проверка: " + СнятьСведенияПоля());
КонецПроцедуры

&НаКлиенте
Функция СнятьСведенияПоля()
	Части = Новый Массив;
	Части.Добавить("адрес=" + Лев(АдресЧата, 160));
	Попытка
		Док = Элементы.ПолеHTML.Документ;
		Части.Добавить("Документ тип=" + Строка(ТипЗнч(Док)));
		Попытка
			Части.Добавить("URL=" + Строка(Док.URL));
		Исключение
			Части.Добавить("URL ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Попытка
			Части.Добавить("title=" + Строка(Док.title));
		Исключение
			Части.Добавить("title ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Попытка
			Части.Добавить("eval=" + Строка(Элементы.ПолеHTML.Документ.parentWindow.eval("String(document.title) + ' agent=' + (typeof window.HarnessAgent)")));
		Исключение
			Части.Добавить("eval ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	Исключение
		Части.Добавить("Документ ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат СтрСоединить(Части, " | ");
КонецФункции

&НаСервере
Процедура Зафиксировать(Текст)
	ЗаписатьСтрокуЖурнала(Текст, Ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьСтрокуЖурнала(Текст, Сбросить)
	Запись = Новый ЗаписьТекста("/tmp/1c-harness-form.log", КодировкаТекста.UTF8, Символы.ПС, Не Сбросить);
	Запись.ЗаписатьСтроку(Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + " | " + Текст);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
