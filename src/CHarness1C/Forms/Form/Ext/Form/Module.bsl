&НаСервере
Функция ПроверкаПараметровЗапроса()
	Кабель = ОписаниеСсылки(СсылкаНоменклатурыПоАртикулу("CBL-325"));
	Розетка = ОписаниеСсылки(СсылкаНоменклатурыПоАртикулу("SCH-ET"));
	ПараметрыЦены = Новый Структура;
	ПараметрыЦены.Вставить("ВидЦен", "Розничная");
	ПараметрыЦены.Вставить("Период", "2026-10-02");
	ПараметрыЦены.Вставить("Номенклатура", Кабель);
	ЦенаКабеля = ВыполнитьЗапросИзJSON(
		"ВЫБРАТЬ Цены.Цена КАК Цена ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, ВидЦен = &ВидЦен) КАК Цены ГДЕ Цены.Номенклатура = &Номенклатура",
		ПараметрыЦены);
	Если Число(ЦенаКабеля.Получить("rowCount")) <> 1
		Или Число(СтрокаРезультата(ЦенаКабеля, 0).Получить("Цена")) <> 85 Тогда
		ВызватьИсключение "params: ожидалась розничная цена кабеля 85";
	КонецЕсли;
	ПараметрыПорога = Новый Структура;
	ПараметрыПорога.Вставить("ВидЦен", "Розничная");
	ПараметрыПорога.Вставить("Минимум", 300);
	Дороже = ВыполнитьЗапросИзJSON(
		"ВЫБРАТЬ Цены.Цена КАК Цена ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦен = &ВидЦен) КАК Цены ГДЕ Цены.Цена >= &Минимум",
		ПараметрыПорога);
	Если Число(Дороже.Получить("rowCount")) <> 2 Тогда
		ВызватьИсключение "params: ожидались 2 цены от 300, получено " + Строка(Дороже.Получить("rowCount"));
	КонецЕсли;
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("Начало", "2026-10-20 00:00:00");
	ПараметрыДокумента.Вставить("Контрагент", "ООО Ромашка");
	Накладная = ВыполнитьЗапросИзJSON(
		"ВЫБРАТЬ Док.Контрагент КАК Контрагент ИЗ Документ.РасходнаяНакладная КАК Док ГДЕ Док.Дата >= &Начало И Док.Контрагент = &Контрагент",
		ПараметрыДокумента);
	Если Число(Накладная.Получить("rowCount")) <> 1
		Или Строка(СтрокаРезультата(Накладная, 0).Получить("Контрагент")) <> "ООО Ромашка" Тогда
		ВызватьИсключение "params: накладная ООО Ромашка не найдена по дате";
	КонецЕсли;
	Список = Новый Массив;
	Список.Добавить(Кабель);
	Список.Добавить(Розетка);
	ПараметрыСписка = Новый Структура;
	ПараметрыСписка.Вставить("Список", Список);
	ПоСсылкам = ВыполнитьЗапросИзJSON(
		"ВЫБРАТЬ Номенклатура.Артикул КАК Артикул ИЗ Справочник.Номенклатура КАК Номенклатура ГДЕ Номенклатура.Ссылка В (&Список)",
		ПараметрыСписка);
	Если Число(ПоСсылкам.Получить("rowCount")) <> 2 Тогда
		ВызватьИсключение "params: ожидались 2 ссылки в списке, получено " + Строка(ПоСсылкам.Получить("rowCount"));
	КонецЕсли;
	Возврат "params=85/2/ромашка/2";
КонецФункции

&НаСервере
Функция СсылкаНоменклатурыПоАртикулу(Артикул)
