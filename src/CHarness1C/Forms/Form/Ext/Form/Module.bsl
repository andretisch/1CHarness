&НаСервере
Функция ОсмотретьМетаданные(Имя)
	ОбъектМД = НайтиМетаданные(Имя);
	Описание = Новый Структура;
	Описание.Вставить("fullName", ОбъектМД.ПолноеИмя());
	Описание.Вставить("name", ОбъектМД.Имя);
	Описание.Вставить("synonym", Строка(ОбъектМД.Синоним));
	ДобавитьКоллекцию(Описание, "attributes", ОбъектМД, "Реквизиты");
	ДобавитьКоллекцию(Описание, "standardAttributes", ОбъектМД, "СтандартныеРеквизиты");
	ДобавитьТабличныеЧасти(Описание, ОбъектМД);
	ДобавитьКоллекцию(Описание, "dimensions", ОбъектМД, "Измерения");
	ДобавитьКоллекцию(Описание, "resources", ОбъектМД, "Ресурсы");
	Попытка
		Описание.Вставить("registerKind", Строка(ОбъектМД.ВидРегистра));
	Исключение
	КонецПопытки;
	Попытка
		Описание.Вставить("periodicity", Строка(ОбъектМД.ПериодичностьРегистраСведений));
	Исключение
	КонецПопытки;
	Возврат Описание;
КонецФункции

&НаСервере
Процедура ДобавитьКоллекцию(Описание, Ключ, ОбъектМД, ИмяСвойства)
	Попытка
		Коллекция = ОбъектМД[ИмяСвойства];
	Исключение
		Возврат;
	КонецПопытки;
	Поля = Новый Массив;
	Для Каждого Поле Из Коллекция Цикл
		Поля.Добавить(ОписаниеПоля(Поле));
	КонецЦикла;
	Описание.Вставить(Ключ, Поля);
